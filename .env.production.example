# ─── Production env (Vercel) ───
# Set these in Vercel Dashboard → Settings → Environment Variables

# ─── API ───
# Leave empty so the browser calls same-origin /api (avoids CORS).
VITE_APP_ENDPOINT_URL=

# Laravel origin for vercel.json / docs (retail API has NO /api prefix on Laravel;
# vercel rewrites /api/:path* → https://host/:path*).
API_PROXY_TARGET=https://tawke3y-eg.com

# ─── Site ───
VITE_SITE_URL=https://tawke3y-eg.com

# ─── Sockets / Realtime ───
# Same as tawke3y-next production: no cPanel Node.js App.
# Keep false — notifications poll REST every ~45s.
VITE_SOCKET_ENABLED=false
