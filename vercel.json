{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tawke3y-eg.com/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://tawke3y-eg.com/storage/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
